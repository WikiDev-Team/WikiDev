    USER {
        int id PK
        string username UK
        string email UK
        string hashed_password
        string token_hash
        string display_name
        string bio
        string avatar_url
        datetime created_at
        datetime updated_at
    }
    PASSWORD_RESET_TOKEN {
        int id PK
        int user_id FK
        string token_hash UK
        datetime expires_at
        datetime used_at
        datetime created_at
    }
    FOLDER {
        int id PK
        string name
        string slug UK
        string description
        string visibility
        int author_id FK
        int parent_folder_id FK
        datetime created_at
        datetime updated_at
    }
    PAGE {
        int id PK
        string title
        string slug UK
        string page_type
        string status
        string summary
        int language_id FK
        int author_id FK
        int parent_page_id FK
        int folder_id FK
        datetime created_at
        datetime updated_at
    }
    PAGE_BLOCK {
        int id PK
        int page_id FK
        int position
        string block_type
        string content
        string language
        string font_size
        datetime created_at
        datetime updated_at
    }
    LANGUAGE { int id PK string name string slug UK }
    TAG { int id PK string name string slug UK }
    COMMENT { int id PK int page_id FK int author_id FK int parent_comment_id FK string body bool is_deleted }
    CODE_EXAMPLE { int id PK int page_id FK int author_id FK string title string code bool is_public }
    PAGE_TAG_LINK { int page_id PK, FK int tag_id PK, FK }
