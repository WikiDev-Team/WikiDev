erDiagram
    USER ||--o{ PAGE : authors
    USER ||--o{ FRIENDSHIP : requests
    USER ||--o{ FRIENDSHIP : receives
    USER ||--o{ PAGE_SHARE : receives
    USER ||--o{ COMMENT : writes
    USER ||--o{ CODE_EXAMPLE : creates
    LANGUAGE ||--o{ PAGE : classifies
    FOLDER ||--o{ PAGE : contains
    PAGE ||--o{ PAGE_SHARE : shares
    PAGE ||--o{ PAGE_BLOCK : contains
    PAGE ||--o{ COMMENT : has
    PAGE ||--o{ CODE_EXAMPLE : has
    PAGE ||--o{ PAGE_TAG_LINK : links
    TAG ||--o{ PAGE_TAG_LINK : links

    USER {
        int id PK
        string username
        string email
        string display_name
        string bio
        string avatar_url
    }

    FRIENDSHIP {
        int id PK
        int requester_id FK
        int addressee_id FK
        string status
        datetime created_at
        datetime updated_at
    }

    PAGE {
        int id PK
        string title
        string slug
        string page_type
        string status
        string visibility
        int author_id FK
        int folder_id FK
    }

    PAGE_SHARE {
        int page_id PK, FK
        int user_id PK, FK
        string permission
    }

    PAGE_BLOCK {
        int id PK
        int page_id FK
        int position
        string block_type
        string content
    }

    LANGUAGE {
        int id PK
        string name
        string slug
    }

    FOLDER {
        int id PK
        int author_id FK
        int parent_folder_id FK
        string name
    }

    TAG {
        int id PK
        string name
        string slug
    }

    PAGE_TAG_LINK {
        int page_id PK, FK
        int tag_id PK, FK
    }

    COMMENT {
        int id PK
        int page_id FK
        int author_id FK
        string body
    }

    CODE_EXAMPLE {
        int id PK
        int page_id FK
        int author_id FK
        string code
    }
