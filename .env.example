# Application
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./wikidev.db
SECURE_COOKIES=false
ENABLE_DEV_LOGIN=false
PASSWORD_RESET_TTL_MINUTES=30

# E-mail: use console locally or smtp in production
MAIL_MODE=console
MAIL_FROM=WikiDev <no-reply@wikidev.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
